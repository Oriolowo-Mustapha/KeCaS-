# ---------------------------------------------------------------------------
# KeCaS backend environment variables — COMMITTED TEMPLATE.
# Copy this file to `.env` and fill in real values. Never commit .env itself.
#
# - Loaded by every backend entry point: the API, `dotnet ef` migrations, tests.
# - Variables already set in the real environment win over .env values.
# - .NET uses double underscores for nesting:
#     ConnectionStrings__Database  ->  ConnectionStrings:Database
# ---------------------------------------------------------------------------

# --- Environment ---
ASPNETCORE_ENVIRONMENT=Development

# --- Seed data ---
# Shared password for the kecas.test accounts created by `dotnet run -- seed`.
# Set your own value in .env before seeding; never commit the real password.
SEED_USERS_PASSWORD=change-me

# --- Supabase PostgreSQL ---
# Supabase gives you two connection strings (Project Settings > Database):
#
#   1. SESSION-mode pooler  (port 5432, host aws-0-<region>.pooler.supabase.com)
#      -> used for MIGRATIONS (KECAS_DATABASE). Session features work here,
#         and it avoids the IPv6-only direct connection.
#
#   2. TRANSACTION-mode pooler (port 6543, same host)
#      -> used by the RUNNING API (ConnectionStrings__Database). Add
#         PgBouncer=true so Npgsql disables prepared statements, which
#         transaction-mode pooling does not support.
#
# Username on the pooler is always:  postgres.<project-ref>
# Replace <project-ref>, <region> and the password with your project's values.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=change-me

# Migrations / design-time (session mode, port 5432):
KECAS_DATABASE=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=change-me;SSL Mode=Require;Trust Server Certificate=true

# Running API (transaction mode, port 6543):
# NOTE: Npgsql 9+ removed the PgBouncer keyword - it now handles
# transaction-mode poolers automatically. No Reset On Close stays valid.
ConnectionStrings__Database=Host=aws-0-<region>.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=change-me;SSL Mode=Require;Trust Server Certificate=true;No Reset On Close=true


# --- Sprint 4 feature flags ---
# Optional modules; a disabled module returns 404 Module.Disabled (design doc 6.1).
FeatureFlags__Notices=false
FeatureFlags__Booking=false
FeatureFlags__Payments=false
FeatureFlags__Feedback=false

# --- Licence encryption (NFR-05) ---
# 32-byte AES-256 key (base64) for driver licence encryption at rest.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
Security__Licence_Key=replace-with-generated-32-byte-base64-key
